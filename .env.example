# ---------------------------------------------------------------------------
# FitForge Agentic Support — configuration
# Everything here points at self-hosted, open-source services. No paid APIs.
# Copy to `.env` and adjust if needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Postgres (relational + pgvector + LangGraph checkpoints) ---------------
POSTGRES_USER=fitforge
POSTGRES_PASSWORD=fitforge
POSTGRES_DB=fitforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fitforge:fitforge@postgres:5432/fitforge

# --- Redis (websocket fan-out to the agent console) ------------------------
REDIS_URL=redis://redis:6379/0

# --- LLM ---------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: Ollama, vLLM, llama.cpp, LM Studio, TGI.
# Swap these three lines to move off Ollama; no code changes required.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama                      # ignored by Ollama, required by the OpenAI client
# qwen2.5-instruct rather than qwen3: qwen3 is a hybrid-thinking model and emits
# <think> blocks by default. On CPU those are pure latency for no benefit here,
# and they interfere with constrained JSON output. qwen2.5-instruct is
# non-thinking and adheres to JSON schemas well at these sizes.
LLM_MODEL=qwen2.5:3b-instruct           # the "reasoning" model: diagnosis, responses
LLM_ROUTER_MODEL=qwen2.5:1.5b-instruct  # cheap/fast model: intent classification only
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=180
LLM_MAX_RETRIES=2

# --- Embeddings ---------------------------------------------------------------
EMBED_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# --- Agent behaviour ----------------------------------------------------------
# Diagnostic steps allowed per issue thread before we stop and escalate.
DIAGNOSTIC_STEP_BUDGET=8
# Model identification must reach this confidence before troubleshooting starts.
MODEL_ID_CONFIDENCE_THRESHOLD=0.85
# Retrieval scores below this mean "we don't actually know" -> escalate.
RETRIEVAL_MIN_SCORE=0.28
# Any quote above this needs a human to approve it.
PAYMENT_HUMAN_APPROVAL_CENTS=50000
MAX_TOOL_FAILURES_PER_ISSUE=3

# --- Retrieval ------------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=40
RRF_K=60

# --- Mock payment service (stands in for a real PSP; zero PCI surface) --------
MOCK_PSP_URL=http://mockpsp:8090

# --- Observability (self-hosted Langfuse; optional, system runs without it) ----
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Seed data generation ------------------------------------------------------
SEED_RANDOM_SEED=20260827
SEED_NUM_MODELS=312
SEED_SCANNED_RATIO=0.15     # fraction of manuals emitted as image-only (exercises OCR)
SEED_MISSING_RATIO=0.05     # fraction of SKUs with no manual at all (exercises coverage gaps)

# --- App -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=local

# --- Exposing the UI through a tunnel (ngrok, Cloudflare, Tailscale) -------
# Vite refuses any request whose Host header is not a loopback name. That is
# DNS-rebinding protection; a tunnel hostname has to be named explicitly.
# A leading dot covers the domain and all subdomains.
#   WEB_ALLOWED_HOSTS=.ngrok-free.dev,.trycloudflare.com
# And, so hot reload reconnects over the tunnel's TLS rather than port 5173:
#   WEB_PUBLIC_HOST=your-subdomain.ngrok-free.dev
WEB_ALLOWED_HOSTS=
WEB_PUBLIC_HOST=
